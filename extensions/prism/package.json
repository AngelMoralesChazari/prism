{
  "name": "prism",
  "displayName": "Prism",
  "description": "Sintaxis, autocompletado y diagnósticos visuales en tiempo real para Prism (.pr)",
  "version": "0.3.0",
  "publisher": "prism",
  "icon": "./icons/Prismv1.png",
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:prism"
  ],
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "contributes": {
    "commands": [
      {
        "command": "prism.toggleBlockComment",
        "title": "Alternar Comentario de Bloque (/* ... */)",
        "category": "Prism"
      }
    ],
    "keybindings": [
      {
        "command": "prism.toggleBlockComment",
        "key": "ctrl+shift+/",
        "when": "editorTextFocus && editorLangId == 'prism'"
      },
      {
        "command": "prism.toggleBlockComment",
        "key": "ctrl+shift+a",
        "when": "editorTextFocus && editorLangId == 'prism'"
      },
      {
        "command": "prism.toggleBlockComment",
        "key": "shift+alt+a",
        "when": "editorTextFocus && editorLangId == 'prism'"
      }
    ],
    "languages": [
      {
        "id": "prism",
        "aliases": [
          "Prism",
          "prism"
        ],
        "extensions": [
          ".pr"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/Prismv1-light.svg",
          "dark": "./icons/Prismv1.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "prism",
        "scopeName": "source.prism",
        "path": "./syntaxes/prism.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "prism",
        "path": "./snippets/prism.code-snippets"
      }
    ]
  }
}
