{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Prism",
  "scopeName": "source.prism",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#keywords" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.prism",
          "begin": "/\\*",
          "end": "\\*/"
        },
        {
          "name": "comment.block.triple-number-sign.prism",
          "begin": "###",
          "end": "###"
        },
        {
          "name": "comment.line.number-sign.prism",
          "match": "#.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.triple.prism",
          "begin": "\"\"\"",
          "end": "\"\"\"",
          "patterns": [
            {
              "name": "constant.character.escape.prism",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.double.prism",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.prism",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.prism",
          "match": "\\b(module|use|atom|formula|nl|let|translate|vertauto|steps|table|verdict)\\b"
        },
        {
          "name": "keyword.operator.prism",
          "match": "\\b(not|and|or|impl|iff)\\b"
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "variable.other.prism",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
        }
      ]
    }
  }
}
