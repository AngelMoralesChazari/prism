{
  "comments": {
    "lineComment": "#",
    "blockComment": ["/*", "*/"]
  },
  "brackets": [
    ["{", "}"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    { "open": "(", "close": ")" },
    { "open": "{", "close": "}" },
    { "open": "\"", "close": "\"", "notIn": ["string"] },
    { "open": "/*", "close": "*/", "notIn": ["string"] }
  ],
  "surroundingPairs": [
    ["(", ")"],
    ["{", "}"],
    ["\"", "\""]
  ],
  "indentationRules": {
    "increaseIndentPattern": "^.*\\{[^}]*$",
    "decreaseIndentPattern": "^\\s*\\}.*$"
  },
  "onEnterRules": [
    {
      "beforeText": "^\\s*(?:nl|atom|let|formula)\\s+\\w+\\s*=\\s*\"[^\"]*$",
      "action": {
        "indentAction": "indent"
      }
    },
    {
      "beforeText": "^\\s*/\\*.*$",
      "afterText": "^\\s*\\*/$",
      "action": {
        "indentAction": "indent",
        "appendText": " * "
      }
    }
  ]
}
