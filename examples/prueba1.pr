# NL → translate → vertauto
# Ejecutar: java -cp out prism.pr.PrcCli run examples/prueba1.pr

module prueba1

use core

atom p = "Escuchar musica"
atom q = "trabajar"

nl proposicion = "trabajo si escucho musica" 
let traduccion = translate(proposicion)

vertauto traduccion {
    steps
    table
    verdict
}