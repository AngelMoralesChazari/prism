module prueba_nl

use core

atom p = "El balanceador de carga redirige el tráfico"
atom q = "El servidor web procesa la solicitud"

nl premisa = "Si el balanceador de carga redirige el tráfico entonces el servidor web procesa la solicitud, y el balanceador de carga redirige el tráfico; pero no es verdad que el servidor web procese la solicitud."
let equivalencia = translate(premisa)

vertauto equivalencia {
    steps
    table
    verdict
}