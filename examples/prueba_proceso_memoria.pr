# Prism v1.0 — caso de estudio: equivalencia lógica de implicaciones contrapositivas
# Ejecutar: java -jar prism.jar run examples/prueba_proceso_memoria.pr

module prueba_proceso_memoria

use core

atom p = "el compilador optimiza el codigo"
atom q = "la ejecucion sea lenta"

nl premisa = "No es cierto que si el compilador optimiza el codigo entonces la ejecucion sea lenta, si y solo si el compilador optimiza el codigo y la ejecucion no es lenta"
let equivalencia = translate(premisa)

vertauto equivalencia {
    steps
    table
    verdict
}
