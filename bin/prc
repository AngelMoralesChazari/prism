#!/usr/bin/env bash
# Prism Compiler & Runtime Launcher (prc) v1.0.0
set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PRISM_HOME="$(cd "$SCRIPT_DIR/.." && pwd)"

JAR_PATH="$PRISM_HOME/prism.jar"
if [ ! -f "$JAR_PATH" ]; then
    JAR_PATH="$PRISM_HOME/lib/prism.jar"
fi

if [ ! -f "$JAR_PATH" ]; then
    echo "Error: No se encontró 'prism.jar' en $PRISM_HOME" >&2
    exit 1
fi

exec java -jar "$JAR_PATH" "$@"

